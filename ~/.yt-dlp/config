# yt-dlp configuration file for robust YouTube extraction

# YouTube specific options
# NOTE: JSON output (-j) is now handled explicitly per command
--no-warnings

# Network and timeout settings
--socket-timeout=30
--sleep-requests=2
--sleep-interval=2

# Output and processing
--ignore-errors
--retries=3
--file-access-retries=3

# Cache settings
--cache-dir=/tmp/yt-dlp-cache

# Quiet operation
--no-progress
