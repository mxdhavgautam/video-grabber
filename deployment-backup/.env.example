# Video Grabber Backend - Environment Variables
# Copy this file to .env.docker and update with your values

# Server Configuration
PORT=3001
NODE_ENV=production

# Frontend Origin (Update with your frontend URLs)
# Multiple origins can be separated by comma
ALLOWED_ORIGINS=https://video-grabber.vercel.app,https://mxdhavgautam.com

# Chrome Profile Directory
# Where daily Chrome profiles will be stored
CHROME_PROFILE_DIR=/app/chrome-profiles

# Video Processing
# Maximum concurrent downloads (prevents VPS overload)
MAX_CONCURRENT_DOWNLOADS=3

# Download timeout in minutes
DOWNLOAD_TIMEOUT_MINUTES=20

# Temporary files location
TEMP_DIR=/app/temp-downloads

# Cleanup interval in minutes (old temp files)
CLEANUP_INTERVAL_MINUTES=30

# Chrome Profile Rotation
# Delete old profiles after this many hours
CHROME_PROFILE_MAX_AGE_HOURS=24

YT_CIPHER_AUTH_SECRET=ea18f3e4e3ff433209978da30271f229
YT_CIPHER_API_KEY=optional-api-key-if-needed