# Backend - Local Development Environment

# Node.js server settings
PORT=3001
NODE_ENV=development

# CORS - allow local frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Persistent storage for yt-dlp downloads and Chrome profiles (relative to project root)
COOKIES_FILE=./runtime/yt-dlp/cookies.txt
CHROME_PROFILE_DIR=./runtime/chrome-profiles

# Secrets used for cipher helper endpoints
YT_CIPHER_AUTH_SECRET=ea18f3e4e3ff433209978da30271f229
YT_CIPHER_API_KEY=optional-api-key-if-needed
