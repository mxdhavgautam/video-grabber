# Local Development Environment

# Frontend - Vite dev server runs on 5173/5174
VITE_API_URL=http://localhost:3001

# Backend - Node.js server
PORT=3001
NODE_ENV=development

# CORS - Allow local frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:3000

# yt-dlp cache directory (for optimization)
# Default: ~/.cache/yt-dlp or /tmp/yt-dlp-cache


YT_CIPHER_AUTH_SECRET=ea18f3e4e3ff433209978da30271f229
YT_CIPHER_API_KEY=optional-api-key-if-needed