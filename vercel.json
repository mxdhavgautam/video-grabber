{
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/grabber/api/extract",
      "destination": "/api/extract/youtube.ts"
    },
    {
      "source": "/grabber/api/download",
      "destination": "/api/download.ts"
    },
    {
      "source": "/grabber",
      "destination": "/grabber/index.html"
    }
  ],
  "headers": [
    {
      "source": "/grabber/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    }
  ]
}

