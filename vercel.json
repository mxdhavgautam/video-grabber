{
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "functions": {
    "server-node.mjs": {
      "runtime": "nodejs18.x"
    }
  },
  "rewrites": [
    {
      "source": "/grabber/api/:path*",
      "destination": "/server-node.mjs"
    },
    {
      "source": "/grabber",
      "destination": "/grabber/index.html"
    }
  ],
  "headers": [
    {
      "source": "/grabber/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    }
  ]
}
