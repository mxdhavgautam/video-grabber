{
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "env": {
    "VITE_API_URL": "https://video-grabber-backend.onrender.com"
  },
  "rewrites": [
    {
      "source": "/api/extract",
      "destination": "/api/extract/youtube.ts"
    },
    {
      "source": "/api/download",
      "destination": "/api/download.ts"
    },
    {
      "source": "/grabber/api/extract",
      "destination": "/api/extract/youtube.ts"
    },
    {
      "source": "/grabber/api/download",
      "destination": "/api/download.ts"
    },
    {
      "source": "/grabber/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/grabber/videograbber.jpeg",
      "destination": "/videograbber.jpeg"
    },
    {
      "source": "/grabber",
      "destination": "/index.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    }
  ]
}

