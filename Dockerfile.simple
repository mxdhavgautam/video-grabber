# Multi-stage build for Video Grabber (Frontend + Backend)
FROM node:22-slim

WORKDIR /app

# Copy package files
COPY package.json package-lock.json* ./

# Install dependencies
RUN npm install

# Copy all source files
COPY . .

# Build frontend
RUN npm run build

# Create temp downloads directory
RUN mkdir -p /app/temp-downloads && chmod 777 /app/temp-downloads

# Expose port
EXPOSE 3001

# Set environment variables
ENV NODE_ENV=production
ENV PORT=3001

# Start the server
CMD ["node", "server-simple.mjs"]

